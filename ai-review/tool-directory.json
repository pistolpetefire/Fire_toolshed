{
  "version": "1.0.0",
  "transport": "Download ES modules and execute in an authorized JavaScript runtime. GitHub Pages does not provide a POST API or MCP server.",
  "runner": "run.mjs",
  "reviewRunner": "review.mjs",
  "evidenceReader": {
    "file": "evidence_index.py",
    "runtime": "Python with pypdf",
    "scope": "Local PDF text index and quote-presence checks; no visual or semantic verification"
  },
  "pdfScaleReader": {
    "file": "pdf_scale.py",
    "runtime": "Python with pypdf",
    "command": "python pdf_scale.py drawing.pdf",
    "scope": "Standard isotropic rectilinear viewport scales; verify against dimension"
  },
  "tools": [
    {
      "name": "pressure_budget",
      "inputs": {
        "availablePsi": "nonnegative",
        "requiredPsi": "nonnegative",
        "lossPsi": "nonnegative",
        "riseFt": "signed finite; positive upwards"
      },
      "scope": "Same-flow pressure comparison; no pump or supply curve interpolation"
    },
    {
      "name": "storage_demand",
      "inputs": {
        "flowGpm": "nonnegative",
        "durationMinutes": "nonnegative",
        "unusableGallons": "optional nonnegative"
      },
      "scope": "Volume arithmetic; no refill credit"
    },
    {
      "name": "occupant_load",
      "inputs": {
        "areaSqFt": "nonnegative",
        "factorSqFtPerPerson": "positive",
        "areaBasis": "net | gross"
      },
      "scope": "Supplied factor; ceiling rounding"
    },
    {
      "name": "battery_capacity",
      "inputs": {
        "standbyAmps": "nonnegative",
        "standbyHours": "nonnegative",
        "alarmAmps": "nonnegative",
        "alarmMinutes": "nonnegative",
        "multiplier": "at least 1"
      },
      "scope": "Supplied loads, durations and allowance"
    },
    {
      "name": "circuit_voltage",
      "inputs": {
        "sourceVolts": "nonnegative",
        "currentAmps": "nonnegative",
        "loopResistanceOhms": "nonnegative"
      },
      "scope": "Lumped-load circuit only"
    },
    {
      "name": "pipe_velocity",
      "inputs": {
        "flowGpm": "nonnegative finite number",
        "insideDiameterIn": "positive actual inside diameter"
      },
      "sourceApp": "velocity-suction",
      "scope": "Velocity arithmetic only; operating flow supplied explicitly"
    },
    {
      "name": "sprinkler_discharge",
      "inputs": {
        "kGpmPerSqrtPsi": "positive finite number",
        "pressurePsi": "nonnegative finite number"
      },
      "sourceApp": "branch-hand-calc",
      "scope": "Discharge arithmetic only; no design criteria selection"
    },
    {
      "name": "pipe_friction",
      "inputs": {
        "flowGpm": "nonnegative finite number",
        "insideDiameterIn": "positive finite number",
        "cFactor": "positive finite number",
        "lengthFt": "nonnegative finite number"
      },
      "sourceApp": "branch-hand-calc",
      "scope": "Hazen-Williams segment friction only"
    },
    {
      "name": "measure_route",
      "inputs": {
        "documentId": "string",
        "page": "positive integer",
        "viewport": {
          "id": "string",
          "bounds": "[xmin,ymin,xmax,ymax]"
        },
        "unitsPerCoordinate": "positive number; actual distance per input coordinate unit",
        "unit": "ft | m | in | mm",
        "verification": {
          "points": "two coordinate pairs",
          "length": "known positive length in output unit",
          "source": "labeled dimension reference"
        },
        "points": "route coordinate pairs"
      },
      "limitations": "Scale extraction and route identification are caller responsibilities. Coordinates must share one page/viewport space."
    },
    {
      "name": "compare_values",
      "inputs": {
        "quantity": "string",
        "unit": "common unit",
        "tolerance": "nonnegative number, default 0",
        "observations": "array of {value,unit,documentId,page,reference}"
      },
      "limitations": "Caller establishes common scenario, datum and revision."
    },
    {
      "name": "review_coverage",
      "inputs": {
        "expectedIds": "unique string array",
        "results": "array of {checkId,status,explanation}"
      },
      "limitations": "Does not establish technical accuracy or compliance."
    }
  ],
  "existingCalculators": {
    "availability": "Three arithmetic adapters available; remaining full calculator workflows are browser-only",
    "source": "workflows.json modules[].tools"
  }
}